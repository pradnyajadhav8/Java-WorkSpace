package p1;

import java.util.ArrayList;
import java.util.Arrays;
import java.util.List;
import java.util.stream.Collectors;

public class Example02 {

	public static void main(String[] args) {

		List<String> friends = Arrays.asList("Ram", "Nitin", "Neha", "Amit", "Priya", "Rahul", "Sneha", "Vikas", "Ravi",
				"Poonam", "pradnya");

		// startWithN startsWithP startsWithR

		List<String> startsWithP = new ArrayList<String>();

		for (String name : friends)
			if (name.startsWith("P"))
				startsWithP.add(name);

		System.out.println(startsWithP);

		System.out.println("-----------------");

		List<String> nameWithP = friends.stream().filter(n -> n.startsWith("P") || n.startsWith("P"))
				.collect(Collectors.toList());

		System.out.println("List starts with p : " + nameWithP);

	}
}
