package moderate;

import java.util.PriorityQueue;
import java.util.Queue;

public class App {
	public static void main(String[] args) {
		
		Task t1 = new Task(1, "Complete assignment", 5);
		Task t2 = new Task(2, "Study Java", 3);
		Task t3 = new Task(3, "Practice coding", 1);
		Task t4 = new Task(4, "Read book", 2);
		Task t5 = new Task(5, "Attend meeting", 4);

		Queue<Task> taskList=new PriorityQueue<Task>();
		
		System.out.println(t1);
		System.out.println(t2);
		System.out.println(t3);
		System.out.println(t4);
		System.out.println(t5);

		System.out.println("_____________________________");
		for(Task task : taskList)
			System.out.println(task);
		
		System.out.println("______________________________");
	}
}
