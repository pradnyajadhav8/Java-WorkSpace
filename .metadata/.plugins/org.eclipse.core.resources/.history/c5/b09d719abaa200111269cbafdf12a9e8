package p1;

import java.util.ArrayList;
import java.util.Arrays;
import java.util.List;

public class Example02 {

	public static void main(String[] args) {
		
			List<String> friends = Arrays.asList("Ram", "Nitin", "Neha", "Amit", "Priya", "Rahul", "Sneha", "Vikas","Ravi","Poonam");
			
			// startWithN  startsWithP  startsWithR
	
			List<String> startsWithP = new ArrayList<String>();
			
			for(String name: friends)
				if(name.startsWith("P"))
					startsWithP.add(name);
			
			System.out.println(startsWithP);
			
			System.out.println("-----------------");
			
			List<String> startsWithP =friends.stream()
											 .filter(n -> n.startsWith("N"));
			
	}
}
